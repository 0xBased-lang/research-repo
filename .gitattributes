# Git attributes for consistent behavior across platforms

# Auto detect text files and normalize to LF
* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf

# Explicitly declare text files
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.py text eol=lf

# Declare files that should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
