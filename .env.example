# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
# ============================================

# --------------------------------------------
# Application Configuration
# --------------------------------------------
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# --------------------------------------------
# Database Configuration
# --------------------------------------------

# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Supabase (Alternative)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxx

# Redis (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --------------------------------------------
# Authentication & Security
# --------------------------------------------

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-different-from-jwt-secret
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-session-secret-key-min-32-characters
SESSION_MAX_AGE=86400000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# Payment Processing
# --------------------------------------------

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# Email Services
# --------------------------------------------

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your App Name

# Resend (Alternative)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# SMTP (Generic)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# --------------------------------------------
# Cloud Storage
# --------------------------------------------

# AWS S3
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Cloudinary (Alternative)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# OAuth Providers
# --------------------------------------------

# Google OAuth
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Twitter/X OAuth
TWITTER_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
TWITTER_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# Monitoring & Logging
# --------------------------------------------

# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxxx
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Log Level
LOG_LEVEL=info
LOG_FORMAT=json

# --------------------------------------------
# MCP Server Integration
# --------------------------------------------

# GitHub MCP Server
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily Search MCP
TAVILY_API_KEY=tvly_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API (if using Claude API directly)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# Third-Party APIs
# --------------------------------------------

# OpenAI (if using)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Slack Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# --------------------------------------------
# Feature Flags & Configuration
# --------------------------------------------

# Enable/Disable Features
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false

# Maintenance Mode
MAINTENANCE_MODE=false

# --------------------------------------------
# Testing & Development
# --------------------------------------------

# Test Database
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/test_db

# Mock Services
MOCK_STRIPE=false
MOCK_EMAIL=true

# Debug Options
DEBUG=app:*
VERBOSE_LOGGING=false

# --------------------------------------------
# CI/CD Secrets (for GitHub Actions)
# --------------------------------------------

# These should be set in GitHub Secrets, not in .env
# Listed here for reference only:

# DEPLOY_HOST=your-server.com
# DEPLOY_USER=deploy
# DEPLOY_KEY=<SSH private key>
# DOCKER_USERNAME=your-dockerhub-username
# DOCKER_PASSWORD=<docker-hub-token>

# --------------------------------------------
# Production Overrides
# --------------------------------------------

# In production, override these:
# NODE_ENV=production
# DATABASE_SSL=true
# REDIS_TLS=true
# LOG_LEVEL=error
# MOCK_EMAIL=false
# MOCK_STRIPE=false
